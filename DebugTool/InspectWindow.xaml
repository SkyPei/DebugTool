<Window x:Class="DebugTool.InspectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DebugTool"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DebugTool.Rule"
        xmlns:service="clr-namespace:DebugTool.Service"
        mc:Ignorable="d"
        Title="EasyXPath" x:Name="inspectWindow" Height="680" Width="400" Loaded="inspectWindow_Loaded" Closed="inspectWindow_Closed" ResizeMode="CanMinimize" Icon="auto_car_64px.ico"
        service:WindowHelper.ShowMaximizeButton="False" service:WindowHelper.ShowMinimizeButton="True" >
    <Window.Resources>
    </Window.Resources>
    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="268*"/>
            <RowDefinition Height="189*"/>
            <RowDefinition Height="194*"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Properties" Margin="10,5,10,5">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="81*"/>
                    <ColumnDefinition Width="290*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="ID" HorizontalContentAlignment="Right"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Name" HorizontalContentAlignment="Right"/>
                <Label Grid.Row="2" Grid.Column="0" Content="Tag" HorizontalContentAlignment="Right"/>
                <Label Grid.Row="3" Grid.Column="0" Content="Class" HorizontalContentAlignment="Right"/>
                <Label Grid.Row="4" Grid.Column="0" Content="Value" HorizontalContentAlignment="Right"/>
                <Label Grid.Row="5" Grid.Column="0" Content="Text" HorizontalContentAlignment="Right"/>
                <!--<Label Grid.Row="6" Grid.Column="0" Content="IFrame" HorizontalContentAlignment="Right"/>-->
                <Label Grid.Row="6" Grid.Column="0" Content="XPath" HorizontalContentAlignment="Right"/>
                <TextBox Grid.Row="0" x:Name="txtID" Grid.Column="1" Text="{Binding ID}"  Margin="5,2,5,3"  />
                <TextBox Grid.Row="1" x:Name="txtName" Grid.Column="1" Text="{Binding Name}"  Margin="5,2,5,3"  />
                <TextBox Grid.Row="2" x:Name="txtTag" Grid.Column="1" Text="{Binding Tag}"  Margin="5,2,5,3"  />
                <TextBox Grid.Row="3" x:Name="txtClass" Grid.Column="1" Text="{Binding Class}"  Margin="5,2,5,3"  />
                <TextBox Grid.Row="4" x:Name="txtValue" Grid.Column="1" Text="{Binding Value}"  Margin="5,2,5,3"  />
                <TextBox Grid.Row="5" x:Name="txtText" Grid.Column="1" Text="{Binding Text}"  Margin="5,2,5,3"  />
                <!--<TextBox Grid.Row="6" x:Name="txtIFrame" Grid.Column="1" Text=""  Margin="5,2,5,3"  />-->
                <TextBox Grid.Row="6" x:Name="txtXPath" Grid.Column="1" Text="{Binding XPath}"  Margin="5,2,5,3"  />
            </Grid>
        </GroupBox>
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="5" >
            <Label Content="OuterHTML" DockPanel.Dock="Top"  HorizontalContentAlignment="Left" Margin="5,0,5,0" />
            <TextBox Margin="5,0,5,0" x:Name="txtHTML" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="{Binding HTML}" Style="{StaticResource MaterialDesignOutlinedTextFieldTextBox}">
                <!--<RichTextBox.Document>
                    <FlowDocument LineHeight="1" ></FlowDocument>
                </RichTextBox.Document>-->
            </TextBox>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="89*"/>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="250*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"  PreviewMouseDown="Button_MouseDown" PreviewMouseUp="Button_MouseUp" Height="Auto" Style="{StaticResource MaterialDesignRaisedLightButton}" materialDesign:ButtonAssist.CornerRadius="5" Margin="20,73,21,73" >
                <materialDesign:PackIcon Kind="CursorPointer" Width="40" Height="40" Margin="-12" />
            </Button>

            <Label Grid.Column="1" Content="IFrame" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
            <materialDesign:Card Grid.Column="2" materialDesign:ShadowAssist.ShadowDepth="Depth3" Margin="0,0,8,2">
                <ListView  ItemsSource="{Binding IFrame}" Margin="8" service:ListViewBehaviour.AutoCopy="True" >
                    <ListView.Resources>
                        <vm:IndexConverter x:Key="idxcvt"/>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ListViewItem}}, Converter={StaticResource idxcvt} }" />
                                    <TextBlock Grid.Column="1" Text="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
